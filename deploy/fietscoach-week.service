[Unit]
Description=Fietscoach weekterugblik op zondagavond
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=fietscoach
Group=fietscoach
WorkingDirectory=/opt/fietscoach
Environment=TZ=Europe/Amsterdam
Environment=LANG=C.UTF-8
Environment=FIETSCOACH_CONFIG=/etc/fietscoach/config.yaml
Environment=FIETSCOACH_DATA=/var/lib/fietscoach
ExecStart=/opt/fietscoach-venv/bin/python -m fietscoach.cli weekterugblik
NoNewPrivileges=yes
